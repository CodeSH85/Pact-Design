{
  "component": {
    "toast": {
      "container": {
        "max-width": {
          "$value": "{global.size.16}",
          "$type": "dimension"
        },
        "padding": {
          "$value": "{system.spacing.md}",
          "$type": "dimension"
        },
        "gap": {
          "$value": "{system.spacing.sm}",
          "$type": "dimension"
        },
        "radius": {
          "$value": "{system.radius.md}",
          "$type": "dimension"
        },
        "shadow": {
          "$value": "{system.elevation.lg}",
          "$type": "shadow"
        },
        "z-index": {
          "$value": "{system.z-index.toast}",
          "$type": "dimension"
        }
      },
      "tone": {
        "default": {
          "color": {
            "bg": {
              "$value": "{system.background.elevated}",
              "$type": "color"
            },
            "border": {
              "$value": "{system.border.default}",
              "$type": "color"
            },
            "text": {
              "$value": "{system.on-surface.default}",
              "$type": "color"
            },
            "icon": {
              "$value": "{system.on-surface.muted}",
              "$type": "color"
            }
          }
        },
        "info": {
          "color": {
            "bg": {
              "$value": "{system.semantic.info-subtle}",
              "$type": "color"
            },
            "border": {
              "$value": "{system.semantic.info-border}",
              "$type": "color"
            },
            "text": {
              "$value": "{system.semantic.on-info-subtle}",
              "$type": "color"
            },
            "icon": {
              "$value": "{system.semantic.info}",
              "$type": "color"
            }
          }
        },
        "success": {
          "color": {
            "bg": {
              "$value": "{system.semantic.success-subtle}",
              "$type": "color"
            },
            "border": {
              "$value": "{system.semantic.success-border}",
              "$type": "color"
            },
            "text": {
              "$value": "{system.semantic.on-success-subtle}",
              "$type": "color"
            },
            "icon": {
              "$value": "{system.semantic.success}",
              "$type": "color"
            }
          }
        },
        "warning": {
          "color": {
            "bg": {
              "$value": "{system.semantic.warning-subtle}",
              "$type": "color"
            },
            "border": {
              "$value": "{system.semantic.warning-border}",
              "$type": "color"
            },
            "text": {
              "$value": "{system.semantic.on-warning-subtle}",
              "$type": "color"
            },
            "icon": {
              "$value": "{system.semantic.warning}",
              "$type": "color"
            }
          }
        },
        "danger": {
          "color": {
            "bg": {
              "$value": "{system.semantic.danger-subtle}",
              "$type": "color"
            },
            "border": {
              "$value": "{system.semantic.danger-border}",
              "$type": "color"
            },
            "text": {
              "$value": "{system.semantic.on-danger-subtle}",
              "$type": "color"
            },
            "icon": {
              "$value": "{system.semantic.danger}",
              "$type": "color"
            }
          }
        }
      }
    }
  }
}
