{
  "name": "@pact-design/tokens",
  "version": "1.0.0",
  "description": "Domain-neutral design token system engineered for dense, compact, and straightforward user interfaces",
  "type": "module",
  "exports": {
    "./css": "./build/css/_variables.css",
    "./meta": "./build/meta/tokens.json",
    "./src/*": "./src/*",
    "./utils/*": "./utils/*"
  },
  "files": [
    "build",
    "src",
    "utils"
  ],
  "scripts": {
    "build": "pnpm build:sd",
    "build:sd": "node ./scripts/build.ts && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.js'",
    "check:tokens": "node utils/color.js"
  },
  "dependencies": {
    "chroma-js": "^3.1.2"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.0"
  }
}
