{
  "name": "@pact-design/react",
  "version": "0.1.0",
  "description": "Dense, compact, and accessible React UI components built on React Aria and Pact Design tokens",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ./scripts/build.ts",
    "test": "node --test 'test/**/*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@pact-design/styles": "workspace:*",
    "clsx": "^2.1.1",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@remixicon/react": "^4.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.18",
    "typescript": "^6.0.3"
  }
}
