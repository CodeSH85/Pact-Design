{
  "name": "@pact-design/styles",
  "version": "0.1.0",
  "description": "Framework-agnostic CSS layers, theme color-scheme rules, and UnoCSS preset for Pact Design",
  "type": "module",
  "exports": {
    "./css": "./build/css/index.css",
    "./css/layered": "./build/css/layered.css",
    "./css/tokens": "./build/css/tokens.css",
    "./css/theme": "./build/css/theme.css",
    "./css/reset": "./build/css/reset.css",
    "./css/components": "./build/css/components.css",
    "./css/components/*": "./build/css/components/*.css",
    "./uno": {
      "types": "./build/uno/preset.d.ts",
      "default": "./build/uno/preset.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "build": "node ./scripts/build.ts && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@pact-design/tokens": "workspace:*"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0"
  }
}
