{
  "global": {
    "duration": {
      "00": {
        "$value": {
          "unit": "ms",
          "value": 0
        },
        "$type": "duration"
      },
      "01": {
        "$value": {
          "unit": "ms",
          "value": 50
        },
        "$type": "duration"
      },
      "02": {
        "$value": {
          "unit": "ms",
          "value": 100
        },
        "$type": "duration"
      },
      "03": {
        "$value": {
          "unit": "ms",
          "value": 150
        },
        "$type": "duration"
      },
      "04": {
        "$value": {
          "unit": "ms",
          "value": 200
        },
        "$type": "duration"
      }
    },
    "easing": {
      "linear": {
        "$value": [0, 0, 1, 1],
        "$type": "cubicBezier"
      },
      "standard": {
        "$value": [0.2, 0, 0, 1],
        "$type": "cubicBezier"
      },
      "enter": {
        "$value": [0, 0, 0.15, 1],
        "$type": "cubicBezier"
      },
      "exit": {
        "$value": [0.3, 0, 1, 1],
        "$type": "cubicBezier"
      }
    }
  }
}
