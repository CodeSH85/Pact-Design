{
  "name": "pact-design-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pact-design/tokens build && pnpm --filter pact-site build",
    "build:tokens": "pnpm --filter @pact-design/tokens build",
    "build:sd": "pnpm --filter @pact-design/tokens build:sd",
    "pretest": "pnpm build:tokens",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "site:dev": "pnpm --filter pact-site dev",
    "site:build": "pnpm build:tokens && pnpm --filter pact-site build",
    "site:preview": "pnpm --filter pact-site preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
