  "license": "ISC",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "chroma-js": "^3.1.2",
    "style-dictionary": "^5.5.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1"
  }
}
