{
  "name": "pact-design",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "exports": {
    "./css": "./build/css/_variables.css",
    "./tokens/*": "./tokens/*",
    "./utils/*": "./utils/*"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "build:sd": "style-dictionary build --config ./scripts/sd.config.js && pnpm test",
    "playground": "node scripts/playground.js",
    "check:tokens": "node utils/color.js",
    "site:dev": "pnpm --filter pact-site dev",
    "site:build": "pnpm build:sd && pnpm --filter pact-site build",
    "site:preview": "pnpm --filter pact-site preview"
  },
  "keywords": [],
