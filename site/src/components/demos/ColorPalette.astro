---
import {
  calculateAPCA,
  colorValueToHex,
  colorValueToOklch,
  cssName,
  loadTokenCatalog,
  readableOn
} from '../../utils/tokens-loader.js'

const { files, lightTokens } = await loadTokenCatalog()

const colorGlobalJson = files['tokens/color/global.json']?.global ?? {}
const scaleNames = [
  'gray',
  'coolGray',
  'warmGray',
  'cyan',
  'blue',
  'indigo',
  'purple',
  'magenta',
  'red',
  'orange',
  'yellow',
  'green',
  'mint'
]

const globalPalettes = scaleNames.map((scale) => {
  const stepsObj = colorGlobalJson[scale] ?? {}
  const steps = Object.keys(stepsObj)
    .filter((k) => !k.startsWith('$'))
    .sort((a, b) => Number(a) - Number(b))
    .map((step) => {
      const tokenId = `global.${scale}.${step}`
      const token = lightTokens.get(tokenId)
      const val = token?.node?.$value
      const hex = colorValueToHex(val)
      const [L, C, H] = colorValueToOklch(val)
      const cssVar = cssName(['global', scale, step])
      const lcWhite = Math.abs(calculateAPCA('#ffffff', val))
      const fg = readableOn(val)
      return {
        step,
        cssVar,
        hex,
        L: L.toFixed(3),
        C: C.toFixed(3),
        H: Math.round(H),
        lcWhite: lcWhite.toFixed(0),
        fg
      }
    })
  return { scale, steps }
})
---

<section class="flex flex-col gap-md pt-md border-t border-border-default">
  <div class="flex items-baseline justify-between gap-sm flex-wrap">
    <h2 class="m-0 text-heading-xs text-on-surface">
      Global 11 階 OKLCH 色票 (Global Color Palettes)
    </h2>
    <span class="m-0 text-body-sm text-on-surface-muted">
      Click any step to copy its CSS variable · Step 500 anchored at L = 0.600
    </span>
  </div>

  <div class="flex flex-col gap-sm">
    {globalPalettes.map((palette) => (
      <div class="bg-layer-2 border border-border-default rounded-xs p-sm flex flex-col gap-xs">
        <div class="flex items-center justify-between text-label-sm">
          <strong class="text-on-surface">{palette.scale}</strong>
          <code class="text-mono-xs text-on-surface-muted">
            --global-{palette.scale.replace(/([A-Z])/g, '-$1').toLowerCase()}-{"{50..1000}"}
          </code>
        </div>
        <div class="grid grid-cols-[repeat(11,minmax(64px,1fr))] gap-3xs overflow-x-auto">
          {palette.steps.map((s) => (
            <button
              type="button"
              class="flex flex-col justify-between h-68px p-2xs border border-black/8 rounded-2xs text-left cursor-pointer transition-transform duration-fast hover:-translate-y-1px"
              style={`background: var(${s.cssVar}); color: ${s.fg};`}
              data-copy={`var(${s.cssVar})`}
              title={`Click to copy var(${s.cssVar})\nOKLCH: ${s.L} ${s.C} ${s.H}\nHEX: ${s.hex}\nAPCA vs White: Lc ${s.lcWhite}`}
            >
              <span class="text-label-xs font-04 tabular-nums">{s.step}</span>
              <span class="text-mono-xs text-11px opacity-92">{s.hex}</span>
              <span class="text-mono-xs text-10px opacity-78 tabular-nums">L {s.L}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div
    id="copy-toast"
    class="fixed bottom-md right-md z-toast py-xs px-sm bg-layer-2 text-on-surface border border-border-strong rounded-xs shadow-elevation-md text-mono-xs"
    role="status"
    aria-live="polite"
    hidden
  />
</section>

<script>
  const toast = document.getElementById('copy-toast')
  let timer = null

  function showToast(text) {
    if (!toast) return
    toast.textContent = `已複製 ${text}`
    toast.hidden = false
    if (timer) clearTimeout(timer)
    timer = setTimeout(() => {
      toast.hidden = true
    }, 1600)
  }

  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async() => {
      const text = btn.getAttribute('data-copy')
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        showToast(text)
      } catch {
        showToast(text)
      }
    })
  })
</script>
