---
import '../styles/global.css'
import { withBase } from '../utils/url.js'

const {
  title = 'Pact Design',
  description = 'Domain-neutral design token system engineered for dense, compact, and straightforward user interfaces.'
} = Astro.props

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'

const navSections = [
  {
    title: 'Getting Started',
    items: [
      { label: 'Overview', href: '/' },
      { label: 'Token Architecture', href: '/foundations/architecture' }
    ]
  },
  {
    title: 'Foundations',
    items: [
      { label: 'Color', href: '/foundations/color' },
      { label: 'Typography', href: '/foundations/typography' },
      { label: 'Spacing', href: '/foundations/spacing' },
      { label: 'Sizing', href: '/foundations/sizing' },
      { label: 'Elevation', href: '/foundations/elevation' },
      { label: 'Motion', href: '/foundations/motion' }
    ]
  },
  {
    title: 'Components (Base UI)',
    items: [
      { label: 'Playground', href: '/components' }
    ]
  }
]

function isCurrentPage(itemHref) {
  const fullHref = withBase(itemHref).replace(/\/$/, '') || '/'
  return currentPath === fullHref
}
---

<!DOCTYPE html>
<html lang="zh-Hant" data-theme="light" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === 'Pact Design' ? 'Pact Design · Design System' : `${title} | Pact Design`}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('pact-theme')
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        const theme = saved === 'dark' || saved === 'light' ? saved : preferred
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body class="h-full w-full overflow-hidden">
    <div class="flex flex-col h-screen bg-base text-on-surface">
      <header class="flex shrink-0 bg-layer-1 w-full items-center justify-between p-md border-b border-border-default">
        <div class="flex w-full">
          <a href={withBase('/')} class="">
            <span class="">P</span>
            <span>Pact Design</span>
          </a>
        </div>

        <div class="flex w-full justify-end">
          <div class="flex gap-sm" role="group" aria-label="切換全站主題">
            <button type="button" class="px-sm" data-theme-btn="light" aria-pressed="true">
              ☀
            </button>
            <button type="button" class="" data-theme-btn="dark" aria-pressed="false">
              ☾
            </button>
            <a
              href="https://github.com/CodeSH85/Pact-UI"
              target="_blank"
              rel="noopener noreferrer"
              class=""
            >
              GitHub
            </a>
          </div>
        </div>
      </header>

      <div class="flex flex-1 min-h-0 overflow-hidden">
        <aside
          class="flex flex-col shrink-0 bg-layer-1 border-r border-border-default py-md overflow-y-auto"
          aria-label="Documentation Navigation"
        >
          {navSections.map((section) => (
            <div class="flex flex-col">
              <div class="px-sm">{section.title}</div>
              {section.items.map((item) => (
                <a
                  href={withBase(item.href)}
                  class="hover-bg-layer-1-hover text-on-surface-muted py-2xs px-sm"
                  aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                </a>
              ))}
            </div>
          ))}
        </aside>

        <main class="flex-1 min-w-0 overflow-y-auto p-lg">
          <div class="bg-layer-1 py-md px-lg">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <script>
      const root = document.documentElement
      const buttons = document.querySelectorAll('[data-theme-btn]')

      function syncThemeButtons(theme) {
        buttons.forEach((btn) => {
          const isMatch = btn.getAttribute('data-theme-btn') === theme
          btn.setAttribute('aria-pressed', String(isMatch))
        })
      }

      const initialTheme = root.getAttribute('data-theme') || 'light'
      syncThemeButtons(initialTheme)

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const nextTheme = btn.getAttribute('data-theme-btn') || 'light'
          root.setAttribute('data-theme', nextTheme)
          localStorage.setItem('pact-theme', nextTheme)
          syncThemeButtons(nextTheme)
          window.dispatchEvent(new CustomEvent('pact:theme-change', { detail: { theme: nextTheme } }))
        })
      })
    </script>
  </body>
</html>
