---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  cssName,
  dimensionToCss,
  formatValue,
  loadTokenCatalog,
  refOf,
  resolveValue,
  toPx
} from '../../utils/tokens-loader.js'

const { lightTokens, darkTokens } = await loadTokenCatalog()

const radiusTokens = [...lightTokens.values()]
  .filter((t) => t.id.startsWith('system.radius.'))
  .map((t) => {
    const resolved = resolveValue(t.node.$value, lightTokens)
    const px = toPx(resolved)
    return {
      key: t.path.at(-1),
      cssVar: cssName(t.path),
      alias: refOf(t.node.$value) ?? '-',
      valueStr: px !== null && px < 500 ? `${px}px (${dimensionToCss(resolved)})` : dimensionToCss(resolved)
    }
  })

const elevationTokens = [...lightTokens.values()]
  .filter((t) => t.id.startsWith('system.elevation.') && t.type === 'shadow')
  .map((t) => {
    const lightResolved = resolveValue(t.node.$value, lightTokens)
    const darkResolved = resolveValue(darkTokens.get(t.id)?.node?.$value, darkTokens)
    return {
      key: t.path.at(-1),
      cssVar: cssName(t.path),
      lightSummary: formatValue('shadow', lightResolved),
      darkAlpha: darkResolved?.color?.alpha ?? '-'
    }
  })

const zIndexTokens = [...lightTokens.values()]
  .filter((t) => t.id.startsWith('system.z-index.'))
  .map((t) => ({
    key: t.path.at(-1),
    cssVar: cssName(t.path),
    alias: refOf(t.node.$value) ?? '-',
    value: resolveValue(t.node.$value, lightTokens)
  }))

const durationTokens = [...lightTokens.values()]
  .filter((t) => t.id.startsWith('system.motion.duration.'))
  .map((t) => ({
    key: t.path.at(-1),
    cssVar: cssName(t.path),
    alias: refOf(t.node.$value) ?? '-',
    value: dimensionToCss(resolveValue(t.node.$value, lightTokens))
  }))

const easingTokens = [...lightTokens.values()]
  .filter((t) => t.id.startsWith('system.motion.easing.'))
  .map((t) => ({
    key: t.path.at(-1),
    cssVar: cssName(t.path),
    alias: refOf(t.node.$value) ?? '-',
    value: formatValue('cubicBezier', resolveValue(t.node.$value, lightTokens))
  }))
---

<BaseLayout title="Border, Elevation & Motion">
  <header class="page-header">
    <span class="page-eyebrow">Foundations · Structure, Depth &amp; Motion</span>
    <h1 class="page-title">Border, Focus Ring, Elevation &amp; Motion</h1>
    <p class="page-desc">
      Pact Design 透過銳利緊湊的圓角（<code>0px</code>–<code>4px</code>）、三種鍵盤導覽 Focus Ring 偏移幾何（外擴、齊平、內縮）、深淺色自適應陰影層級與純功能性緩動曲線（<code>0ms</code>–<code>200ms</code>），打造高精準度的專業工作區體驗。
    </p>
  </header>

  <!-- Section 1: Border Radius & Focus Ring Geometry -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">圓角與鍵盤焦點幾何 (Border Radius &amp; Focus Ring Geometry)</h2>
      <span class="section-subtitle">Sharp radii for dense panels · Three focus offsets for buttons, inputs, and grid cells</span>
    </div>

    <div class="pact-grid pact-grid-2">
      <div class="pact-panel">
        <div class="panel-heading">
          <strong>Border Radii (system.radius.*)</strong>
          <span class="pact-badge">0px – 999rem</span>
        </div>
        <div class="radius-grid">
          {radiusTokens.map((r) => (
            <div class="radius-card">
              <div class="radius-box" style={`border-radius: var(${r.cssVar});`}>
                <span class="mono">{r.key}</span>
              </div>
              <code style="font-size: 11px;">{r.cssVar}</code>
              <span class="mono tabular-nums" style="color: var(--system-text-muted); font-size: 11px;">{r.valueStr}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="pact-panel">
        <div class="panel-heading">
          <strong>Focus Ring Geometry (system.focus.*)</strong>
          <span class="pact-badge pact-badge-primary">Click / Tab to test focus</span>
        </div>

        <div class="focus-stack">
          <div class="focus-demo-item">
            <button type="button" class="focus-box focus-default">
              Default Outer Focus (+2px)
            </button>
            <div class="focus-meta">
              <code>--system-focus-offset-default: 2px</code>
              <span>標準獨立按鈕與卡片，外框與元件邊界保持 2px 呼吸空間。</span>
            </div>
          </div>

          <div class="focus-demo-item">
            <button type="button" class="focus-box focus-flush">
              Flush Focus (0px)
            </button>
            <div class="focus-meta">
              <code>--system-focus-offset-flush: 0px</code>
              <span>表單輸入框與下拉選單，焦點外框緊貼邊框不外溢。</span>
            </div>
          </div>

          <div class="focus-demo-item">
            <button type="button" class="focus-box focus-inset">
              Inset Focus (-2px · Grid Cell)
            </button>
            <div class="focus-meta">
              <code>--system-focus-offset-inset: -2px</code>
              <span>適用於 <code>overflow: hidden</code> 的高密度資料表儲存格（Data Grid Cell）或緊鄰頁籤，避免焦點外框被裁切。</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Elevation & Z-Index -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">海拔陰影與 Z-Index 堆疊層級 (Elevation &amp; Z-Index Scale)</h2>
      <span class="section-subtitle">Dark mode automatically boosts shadow alpha (0.28–0.68) for depth perception</span>
    </div>

    <div class="elevation-grid">
      {elevationTokens.map((el) => (
        <div class="elevation-card" style={`box-shadow: var(${el.cssVar});`}>
          <div class="elevation-top">
            <span class="pact-badge pact-badge-primary">elevation.{el.key}</span>
            <span class="mono tabular-nums" style="color: var(--system-text-muted);">Dark α {el.darkAlpha}</span>
          </div>
          <code>{el.cssVar}</code>
          <span class="mono tabular-nums" style="color: var(--system-text-secondary); font-size: 11px;">
            {el.lightSummary}
          </span>
        </div>
      ))}
    </div>

    <div class="pact-table-wrap">
      <table class="pact-table">
        <thead>
          <tr>
            <th>Z-Index 語意層級</th>
            <th>CSS Variable</th>
            <th>Global 參照</th>
            <th>數值</th>
            <th>視覺化堆疊深度</th>
          </tr>
        </thead>
        <tbody>
          {zIndexTokens.map((z) => (
            <tr>
              <td><span class="pact-badge">{z.key}</span></td>
              <td><code>{z.cssVar}</code></td>
              <td class="mono" style="color: var(--system-text-muted);">{z.alias}</td>
              <td class="mono tabular-nums"><strong>{z.value}</strong></td>
              <td>
                <div class="z-bar-track">
                  <div class="z-bar-fill" style={`width: ${Math.max(4, (Number(z.value) / 600) * 100)}%;`} />
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 3: Functional Motion -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">功能性動效與緩動曲線 (Functional Motion)</h2>
      <span class="section-subtitle">0ms–200ms crisp transitions · Zero spring overshoot</span>
    </div>

    <div class="pact-panel motion-playground">
      <div class="motion-toolbar">
        <div>
          <strong>互動動效測試台 (Interactive Transition Runner)</strong>
          <span style="color: var(--system-text-muted); margin-left: var(--system-spacing-xs);">
            點擊右側按鈕同步觸發所有時長與緩動曲線方塊位移
          </span>
        </div>
        <button type="button" id="btn-run-motion" class="pact-btn pact-btn-primary">
          ▶ 切換動效位移 (Toggle Motion)
        </button>
      </div>

      <div class="pact-grid pact-grid-2">
        <div class="motion-col">
          <div class="motion-col-title">Durations (搭配 --system-motion-easing-default)</div>
          {durationTokens.map((d) => (
            <div class="motion-row">
              <div class="motion-label mono tabular-nums">
                <code>{d.cssVar}</code>
                <strong>{d.value}</strong>
              </div>
              <div class="motion-track">
                <div
                  class="motion-puck"
                  style={`transition: transform var(${d.cssVar}) var(--system-motion-easing-default);`}
                />
              </div>
            </div>
          ))}
        </div>

        <div class="motion-col">
          <div class="motion-col-title">Easing Curves (搭配 --system-motion-duration-slower: 200ms)</div>
          {easingTokens.map((e) => (
            <div class="motion-row">
              <div class="motion-label mono tabular-nums">
                <code>{e.cssVar}</code>
                <span style="color: var(--system-text-muted);">{e.value}</span>
              </div>
              <div class="motion-track">
                <div
                  class="motion-puck motion-puck-easing"
                  style={`transition: transform var(--system-motion-duration-slower) var(${e.cssVar});`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const runBtn = document.getElementById('btn-run-motion')
  const playground = document.querySelector('.motion-playground')

  runBtn?.addEventListener('click', () => {
    playground?.classList.toggle('is-shifted')
  })
</script>

<style>
  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--system-spacing-md);
  }

  .radius-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(115px, 1fr));
    gap: var(--system-spacing-xs);
  }

  .radius-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--system-spacing-3xs);
    padding: var(--system-spacing-xs);
    background: var(--system-background-layer-1);
    border: var(--system-border-width-sm) solid var(--system-border-subtle);
    border-radius: var(--system-radius-xs);
    text-align: center;
  }

  .radius-box {
    display: grid;
    place-items: center;
    width: 56px;
    height: 40px;
    background: var(--system-semantic-primary-subtle);
    color: var(--system-semantic-on-primary-subtle);
    border: var(--system-border-width-md) solid var(--system-semantic-primary);
  }

  .focus-stack {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-sm);
  }

  .focus-demo-item {
    display: flex;
    align-items: center;
    gap: var(--system-spacing-md);
    padding: var(--system-spacing-xs);
    background: var(--system-background-layer-1);
    border: var(--system-border-width-sm) solid var(--system-border-subtle);
    border-radius: var(--system-radius-xs);
  }

  .focus-box {
    width: 190px;
    flex-shrink: 0;
    height: var(--system-control-height-md);
    background: var(--system-background-layer-2);
    border: var(--system-border-width-sm) solid var(--system-border-strong);
    border-radius: var(--system-radius-2xs);
    font: var(--system-font-label-xs);
    cursor: pointer;
    outline: var(--system-focus-width) var(--system-focus-style) var(--system-border-focus);
  }

  .focus-default {
    outline-offset: var(--system-focus-offset-default);
  }

  .focus-flush {
    outline-offset: var(--system-focus-offset-flush);
  }

  .focus-inset {
    outline-offset: var(--system-focus-offset-inset);
  }

  .focus-meta {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-3xs);
    font: var(--system-font-body-xs);
    color: var(--system-text-secondary);
  }

  .elevation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
    gap: var(--system-spacing-md);
  }

  .elevation-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
    padding: var(--system-spacing-md);
    background: var(--system-background-elevated);
    border: var(--system-border-width-sm) solid var(--system-border-subtle);
    border-radius: var(--system-radius-xs);
  }

  .elevation-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .z-bar-track {
    height: 10px;
    background: var(--system-background-layer-1);
    border-radius: var(--system-radius-2xs);
    overflow: hidden;
  }

  .z-bar-fill {
    height: 100%;
    background: var(--system-semantic-primary);
  }

  .motion-playground {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-md);
  }

  .motion-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--system-spacing-sm);
    padding-bottom: var(--system-spacing-sm);
    border-bottom: var(--system-border-width-sm) solid var(--system-border-default);
    flex-wrap: wrap;
  }

  .motion-col {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
  }

  .motion-col-title {
    font: var(--system-font-label-xs);
    color: var(--system-text-secondary);
    margin-bottom: var(--system-spacing-3xs);
  }

  .motion-row {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-3xs);
  }

  .motion-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .motion-track {
    position: relative;
    height: 24px;
    padding: 3px;
    background: var(--system-background-layer-1);
    border: var(--system-border-width-sm) solid var(--system-border-default);
    border-radius: var(--system-radius-2xs);
    overflow: hidden;
  }

  .motion-puck {
    width: 36px;
    height: 16px;
    border-radius: var(--system-radius-2xs);
    background: var(--system-semantic-primary);
    transform: translateX(0);
  }

  .motion-puck-easing {
    background: var(--system-semantic-info);
  }

  .motion-playground.is-shifted .motion-puck {
    transform: translateX(220px);
  }
</style>
