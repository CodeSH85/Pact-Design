---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { loadTokenCatalog } from '../../utils/tokens-loader.js'

const { files, lightTokens, darkTokens } = await loadTokenCatalog()

const fileStats = Object.entries(files).map(([filePath, json]) => {
  const parts = filePath.split('/')
  const category = parts[1]
  const fileName = parts[2]
  const tier = fileName.startsWith('global') ? 'Global' : 'System'
  const theme = fileName.includes('.dark.')
    ? 'Dark'
    : fileName.includes('.light.')
      ? 'Light'
      : 'Shared'

  let count = 0
  const countLeaves = (node) => {
    if (!node || typeof node !== 'object' || Array.isArray(node)) return
    if ('$value' in node) {
      count += 1
      return
    }
    for (const [k, v] of Object.entries(node)) {
      if (!k.startsWith('$')) countLeaves(v)
    }
  }
  countLeaves(json)

  return { filePath, category, tier, theme, count }
})
---

<BaseLayout title="Token Architecture">
  <header class="page-header">
    <span class="page-eyebrow">Foundations · Specification</span>
    <h1 class="page-title">Token Architecture</h1>
    <p class="page-desc">
      Pact Design 嚴格遵循 <strong>W3C Design Tokens Community Group (DTCG) 2025.10</strong> 規範，透過三層式語意架構（Global → System → Component）與 Style Dictionary v5 編譯管線，產出零執行期負擔的 CSS Custom Properties。
    </p>
  </header>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">架構統計總覽 (Token Inventory)</h2>
      <span class="section-subtitle">Compiled directly from <code>tokens/**/*.json</code></span>
    </div>

    <div class="pact-grid pact-grid-3">
      <div class="pact-panel stat-card">
        <span class="stat-label">JSON SOURCE FILES</span>
        <strong class="stat-value tabular-nums">{fileStats.length}</strong>
        <span class="stat-meta">Across 7 token categories</span>
      </div>
      <div class="pact-panel stat-card">
        <span class="stat-label">LIGHT THEME TOKENS</span>
        <strong class="stat-value tabular-nums">{lightTokens.size}</strong>
        <span class="stat-meta">Global + System (Light)</span>
      </div>
      <div class="pact-panel stat-card">
        <span class="stat-label">DARK THEME TOKENS</span>
        <strong class="stat-value tabular-nums">{darkTokens.size}</strong>
        <span class="stat-meta">100% key parity with Light mode</span>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">W3C DTCG 2025.10 格式與複合展開 (Schema &amp; Expansion)</h2>
      <span class="section-subtitle">Structured <code>$value</code> &amp; <code>$type</code> with CSS reference preservation</span>
    </div>

    <div class="pact-grid pact-grid-2">
      <div class="pact-panel code-panel">
        <div class="code-panel-header">
          <strong>1. DTCG OKLCH Color &amp; Alias Token (JSON)</strong>
          <span class="pact-badge">tokens/color/</span>
        </div>
        <pre class="code-block"><code>{`// tokens/color/global.json
{
  "global": {
    "indigo": {
      "500": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.6, 0.192, 274.9733],
          "alpha": 1,
          "hex": "#5c64eb"
        },
        "$type": "color"
      }
    }
  }
}

// tokens/color/system.light.json
{
  "system": {
    "semantic": {
      "primary": {
        "$value": "{global.indigo.500}",
        "$type": "color"
      }
    }
  }
}`}</code></pre>
      </div>

      <div class="pact-panel code-panel">
        <div class="code-panel-header">
          <strong>2. 編譯輸出之 CSS Custom Properties</strong>
          <span class="pact-badge pact-badge-primary">build/css/_variables.css</span>
        </div>
        <pre class="code-block"><code>{`:root, [data-theme="light"] {
  /* 保留精確 OKLCH 座標 */
  --global-indigo-500: oklch(0.6 0.192 274.9733);

  /* outputReferences: true 保留動態 var() 參照鏈 */
  --system-semantic-primary: var(--global-indigo-500);

  /* 複合 Typography 自動展開子屬性與 font 縮寫 */
  --system-font-body-sm-font-family: var(--global-font-family-sans);
  --system-font-body-sm-font-size: var(--global-font-size-04);
  --system-font-body-sm-font-weight: var(--global-font-weight-02);
  --system-font-body-sm-line-height: var(--global-font-line-height-07);
  --system-font-body-sm-letter-spacing: var(--global-font-letter-spacing-05);
  --system-font-body-sm: var(--system-font-body-sm-font-weight)
    var(--system-font-body-sm-font-size)/var(--system-font-body-sm-line-height)
    var(--system-font-body-sm-font-family);
}`}</code></pre>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">Token 原始檔案清單 (Source Files)</h2>
      <span class="section-subtitle">7 categories organized by tier and theme</span>
    </div>

    <div class="pact-table-wrap">
      <table class="pact-table">
        <thead>
          <tr>
            <th>檔案路徑 (File Path)</th>
            <th>分類 (Category)</th>
            <th>層級 (Tier)</th>
            <th>主題 (Theme)</th>
            <th style="text-align: right;">Token 數量</th>
          </tr>
        </thead>
        <tbody>
          {fileStats.map((item) => (
            <tr>
              <td><code>{item.filePath}</code></td>
              <td><span class="pact-badge">{item.category}</span></td>
              <td>
                <span class={`pact-badge ${item.tier === 'System' ? 'pact-badge-primary' : ''}`}>
                  {item.tier}
                </span>
              </td>
              <td>
                <span class={`pact-badge ${item.theme === 'Dark' ? 'pact-badge-info' : item.theme === 'Light' ? 'pact-badge-warning' : ''}`}>
                  {item.theme}
                </span>
              </td>
              <td class="tabular-nums mono" style="text-align: right;">{item.count}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .stat-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-2xs);
  }

  .stat-label {
    font: var(--system-font-mono-xs);
    color: var(--system-text-muted);
  }

  .stat-value {
    font: var(--system-font-heading-lg);
    color: var(--system-text-primary);
  }

  .stat-meta {
    font: var(--system-font-body-xs);
    color: var(--system-text-secondary);
  }

  .code-panel {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
    padding: 0;
    overflow: hidden;
  }

  .code-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--system-spacing-xs);
    padding: var(--system-spacing-xs) var(--system-spacing-md);
    background: var(--system-background-layer-1);
    border-bottom: var(--system-border-width-sm) solid var(--system-border-default);
    font: var(--system-font-label-xs);
  }

  .code-block {
    margin: 0;
    padding: var(--system-spacing-md);
    overflow-x: auto;
    color: var(--system-text-primary);
    background: var(--system-background-layer-2);
  }
</style>
