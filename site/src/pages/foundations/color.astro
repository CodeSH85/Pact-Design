---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  calculateAPCA,
  colorValueToHex,
  colorValueToOklch,
  cssName,
  loadTokenCatalog,
  readableOn,
  refOf,
  resolveValue
} from '../../utils/tokens-loader.js'

const { files, lightTokens, darkTokens } = await loadTokenCatalog()

const colorGlobalJson = files['tokens/color/global.json']?.global ?? {}
const scaleNames = [
  'gray',
  'coolGray',
  'warmGray',
  'cyan',
  'blue',
  'indigo',
  'purple',
  'magenta',
  'red',
  'orange',
  'yellow',
  'green',
  'mint'
]

const globalPalettes = scaleNames.map((scale) => {
  const stepsObj = colorGlobalJson[scale] ?? {}
  const steps = Object.keys(stepsObj)
    .filter((k) => !k.startsWith('$'))
    .sort((a, b) => Number(a) - Number(b))
    .map((step) => {
      const tokenId = `global.${scale}.${step}`
      const token = lightTokens.get(tokenId)
      const val = token?.node?.$value
      const hex = colorValueToHex(val)
      const [L, C, H] = colorValueToOklch(val)
      const cssVar = cssName(['global', scale, step])
      const lcWhite = Math.abs(calculateAPCA('#ffffff', val))
      const lcBlack = Math.abs(calculateAPCA('#000000', val))
      const fg = readableOn(val)
      return {
        step,
        cssVar,
        hex,
        L: L.toFixed(3),
        C: C.toFixed(3),
        H: Math.round(H),
        lcWhite: lcWhite.toFixed(0),
        lcBlack: lcBlack.toFixed(0),
        fg
      }
    })
  return { scale, steps }
})

const semanticRoles = ['primary', 'secondary', 'success', 'warning', 'danger', 'info', 'neutral']

const semanticRoleSpecs = semanticRoles.map((role) => {
  const getRoleThemeData = (tokenMap) => {
    const solidBg = resolveValue(tokenMap.get(`system.semantic.${role}`)?.node?.$value, tokenMap)
    const solidFg = resolveValue(tokenMap.get(`system.semantic.on-${role}`)?.node?.$value, tokenMap)
    const subtleBg = resolveValue(tokenMap.get(`system.semantic.${role}-subtle`)?.node?.$value, tokenMap)
    const subtleFg = resolveValue(tokenMap.get(`system.semantic.on-${role}-subtle`)?.node?.$value, tokenMap)
    const solidLc = Math.abs(calculateAPCA(solidFg, solidBg)).toFixed(1)
    const subtleLc = Math.abs(calculateAPCA(subtleFg, subtleBg)).toFixed(1)
    return {
      solidRef: refOf(tokenMap.get(`system.semantic.${role}`)?.node?.$value),
      subtleRef: refOf(tokenMap.get(`system.semantic.${role}-subtle`)?.node?.$value),
      solidLc,
      subtleLc
    }
  }

  return {
    role,
    cssPrefix: `--system-semantic-${role}`,
    light: getRoleThemeData(lightTokens),
    dark: getRoleThemeData(darkTokens)
  }
})

const surfaceAndTextIds = [
  'system.background.base',
  'system.background.layer-1',
  'system.background.layer-2',
  'system.background.elevated',
  'system.background.hover',
  'system.background.active',
  'system.background.selected',
  'system.background.selected-hover',
  'system.text.primary',
  'system.text.secondary',
  'system.text.muted',
  'system.text.disabled',
  'system.border.subtle',
  'system.border.default',
  'system.border.strong',
  'system.border.focus'
]

const surfaceAndTextRows = surfaceAndTextIds.map((id) => {
  const lTok = lightTokens.get(id)
  const dTok = darkTokens.get(id)
  const lVal = resolveValue(lTok?.node?.$value, lightTokens)
  const dVal = resolveValue(dTok?.node?.$value, darkTokens)
  return {
    id,
    cssVar: cssName(id),
    lightRef: refOf(lTok?.node?.$value) ?? '-',
    darkRef: refOf(dTok?.node?.$value) ?? '-',
    lightHex: colorValueToHex(lVal),
    darkHex: colorValueToHex(dVal)
  }
})
---

<BaseLayout title="Color & APCA Contrast">
  <header class="page-header">
    <span class="page-eyebrow">Foundations · Color System</span>
    <h1 class="page-title">Color &amp; APCA Perceptual Contrast</h1>
    <p class="page-desc">
      Pact Design 的色彩系統建立於 <strong>OKLCH 均勻感知色彩空間</strong>，所有 13 組色系的 <code>500</code> 中間色階皆錨定於感知明度 <code>L = 0.600</code>（對白字達到 APCA <code>|Lc| &ge; 60</code>），並嚴格校準淺色與深色主題下的 Solid 與 Subtle 狀態對比。
    </p>
  </header>

  <!-- Section 1: Workspace Surface Layering Preview -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">工作區背景與文字階層 (Workspace Surfaces &amp; Text Hierarchy)</h2>
      <span class="section-subtitle">Switch Light / Dark in topbar to inspect live surface luminance steps</span>
    </div>

    <div class="surface-demo-canvas">
      <div class="surface-layer surface-base">
        <div class="surface-meta">
          <code>--system-background-base</code>
          <span class="pact-badge">App Canvas</span>
        </div>
        <div class="surface-layer surface-layer-1">
          <div class="surface-meta">
            <code>--system-background-layer-1</code>
            <span class="pact-badge">Sidebar / Header Strip</span>
          </div>
          <div class="surface-layer surface-layer-2">
            <div class="surface-meta">
              <code>--system-background-layer-2</code>
              <span class="pact-badge pact-badge-primary">Primary Panel / Data Table</span>
            </div>
            <div class="text-hierarchy-row">
              <span style="color: var(--system-text-primary); font-weight: 600;">Primary Text (--system-text-primary)</span>
              <span style="color: var(--system-text-secondary);">Secondary Text (--system-text-secondary)</span>
              <span style="color: var(--system-text-muted);">Muted Text (--system-text-muted)</span>
              <span style="color: var(--system-text-disabled);">Disabled Text (--system-text-disabled)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="pact-table-wrap">
      <table class="pact-table">
        <thead>
          <tr>
            <th>預設色票預覽</th>
            <th>CSS Custom Property</th>
            <th>Light 參照 (Alias &amp; HEX)</th>
            <th>Dark 參照 (Alias &amp; HEX)</th>
          </tr>
        </thead>
        <tbody>
          {surfaceAndTextRows.map((row) => (
            <tr>
              <td>
                <span class="inline-swatch" style={`background: var(${row.cssVar});`} />
              </td>
              <td>
                <button type="button" class="copy-var-btn mono" data-copy={`var(${row.cssVar})`}>
                  {row.cssVar}
                </button>
              </td>
              <td class="mono tabular-nums">
                <span class="swatch-dot" style={`background: ${row.lightHex};`} />
                {row.lightRef} <span style="color: var(--system-text-muted);">({row.lightHex})</span>
              </td>
              <td class="mono tabular-nums">
                <span class="swatch-dot" style={`background: ${row.darkHex};`} />
                {row.darkRef} <span style="color: var(--system-text-muted);">({row.darkHex})</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 2: Semantic Roles (Solid Action vs Subtle Container) -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">語意狀態色：Solid 互動控制項 vs. Subtle 狀態容器</h2>
      <span class="section-subtitle">Calibrated for both high-prominence actions and low-noise dense table badges</span>
    </div>

    <div class="pact-grid pact-grid-2">
      {semanticRoleSpecs.map((spec) => (
        <div class="pact-panel role-card">
          <div class="role-card-header">
            <strong class="role-name">{spec.role.toUpperCase()}</strong>
            <code style="color: var(--system-text-muted);">{spec.cssPrefix}-*</code>
          </div>

          <div class="role-preview-row">
            <button
              type="button"
              class="role-solid-demo"
              style={`
                --demo-bg: var(--system-semantic-${spec.role});
                --demo-hover: var(--system-semantic-${spec.role}-hover);
                --demo-active: var(--system-semantic-${spec.role}-active);
                --demo-fg: var(--system-semantic-on-${spec.role});
              `}
            >
              Solid Action (Hover / Active)
            </button>

            <span
              class="role-subtle-demo"
              style={`
                background: var(--system-semantic-${spec.role}-subtle);
                color: var(--system-semantic-${spec.role === 'neutral' ? 'on-neutral-subtle' : `on-${spec.role}-subtle`});
                border-color: var(--system-semantic-${spec.role}-border);
              `}
            >
              ● Subtle Badge
            </span>
          </div>

          <div class="role-metrics mono tabular-nums">
            <div>
              <span style="color: var(--system-text-muted);">Light APCA:</span>{' '}
              Solid <strong>Lc {spec.light.solidLc}</strong> · Subtle <strong>Lc {spec.light.subtleLc}</strong>
            </div>
            <div>
              <span style="color: var(--system-text-muted);">Dark APCA:</span>{' '}
              Solid <strong>Lc {spec.dark.solidLc}</strong> · Subtle <strong>Lc {spec.dark.subtleLc}</strong>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 3: 13 Global 11-Step OKLCH Palettes -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">Global 11 階 OKLCH 色票 (Global Color Palettes)</h2>
      <span class="section-subtitle">Click any step to copy its CSS variable · Step 500 anchored at L = 0.600</span>
    </div>

    <div class="palette-stack">
      {globalPalettes.map((palette) => (
        <div class="pact-panel palette-row">
          <div class="palette-title-bar">
            <strong>{palette.scale}</strong>
            <code style="color: var(--system-text-muted);">--global-{palette.scale.replace(/([A-Z])/g, '-$1').toLowerCase()}-{"{50..1000}"}</code>
          </div>
          <div class="swatch-strip">
            {palette.steps.map((s) => (
              <button
                type="button"
                class="swatch-cell"
                style={`background: var(${s.cssVar}); color: ${s.fg};`}
                data-copy={`var(${s.cssVar})`}
                title={`Click to copy var(${s.cssVar})\nOKLCH: ${s.L} ${s.C} ${s.H}\nHEX: ${s.hex}\nAPCA vs White: Lc ${s.lcWhite}`}
              >
                <span class="swatch-step tabular-nums">{s.step}</span>
                <span class="swatch-hex mono">{s.hex}</span>
                <span class="swatch-l mono tabular-nums">L {s.L}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div id="copy-toast" class="copy-toast" role="status" aria-live="polite" hidden></div>
</BaseLayout>

<script>
  const toast = document.getElementById('copy-toast')
  let timer = null

  function showToast(text) {
    if (!toast) return
    toast.textContent = `已複製 ${text}`
    toast.hidden = false
    if (timer) clearTimeout(timer)
    timer = setTimeout(() => {
      toast.hidden = true
    }, 1600)
  }

  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async() => {
      const text = btn.getAttribute('data-copy')
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        showToast(text)
      } catch {
        showToast(text)
      }
    })
  })
</script>

<style>
  .surface-demo-canvas {
    border-radius: var(--system-radius-xs);
    overflow: hidden;
  }

  .surface-layer {
    padding: var(--system-spacing-md);
    border: var(--system-border-width-sm) solid var(--system-border-default);
    border-radius: var(--system-radius-xs);
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-sm);
  }

  .surface-base {
    background: var(--system-background-base);
  }

  .surface-layer-1 {
    background: var(--system-background-layer-1);
  }

  .surface-layer-2 {
    background: var(--system-background-layer-2);
    box-shadow: var(--system-elevation-xs);
  }

  .surface-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--system-spacing-xs);
  }

  .text-hierarchy-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--system-spacing-md);
    padding-top: var(--system-spacing-xs);
    border-top: var(--system-border-width-sm) solid var(--system-border-subtle);
    font: var(--system-font-body-sm);
  }

  .inline-swatch {
    display: inline-block;
    width: 28px;
    height: 18px;
    border-radius: var(--system-radius-2xs);
    border: var(--system-border-width-sm) solid var(--system-border-strong);
    vertical-align: middle;
  }

  .swatch-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: var(--system-radius-full);
    border: var(--system-border-width-sm) solid var(--system-border-default);
    margin-right: var(--system-spacing-2xs);
    vertical-align: middle;
  }

  .copy-var-btn {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--system-semantic-primary);
    cursor: pointer;
  }

  .copy-var-btn:hover {
    text-decoration: underline;
  }

  .role-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-sm);
  }

  .role-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .role-name {
    font: var(--system-font-label-sm);
    letter-spacing: var(--system-font-label-sm-letter-spacing);
  }

  .role-preview-row {
    display: flex;
    align-items: center;
    gap: var(--system-spacing-sm);
    flex-wrap: wrap;
  }

  .role-solid-demo {
    height: var(--system-control-height-sm);
    padding: 0 var(--system-spacing-sm);
    border-radius: var(--system-radius-xs);
    border: var(--system-border-width-sm) solid transparent;
    background: var(--demo-bg);
    color: var(--demo-fg);
    font: var(--system-font-label-xs);
    cursor: pointer;
    transition: background-color var(--system-motion-duration-fast) var(--system-motion-easing-default);
  }

  .role-solid-demo:hover {
    background: var(--demo-hover);
  }

  .role-solid-demo:active {
    background: var(--demo-active);
  }

  .role-subtle-demo {
    display: inline-flex;
    align-items: center;
    height: var(--system-control-height-xs);
    padding: 0 var(--system-spacing-xs);
    border-radius: var(--system-radius-2xs);
    border: var(--system-border-width-sm) solid;
    font: var(--system-font-label-xs);
  }

  .role-metrics {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-3xs);
    padding-top: var(--system-spacing-2xs);
    border-top: var(--system-border-width-sm) solid var(--system-border-subtle);
    color: var(--system-text-secondary);
  }

  .palette-stack {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-sm);
  }

  .palette-row {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
    padding: var(--system-spacing-sm);
  }

  .palette-title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font: var(--system-font-label-sm);
  }

  .swatch-strip {
    display: grid;
    grid-template-columns: repeat(11, minmax(64px, 1fr));
    gap: var(--system-spacing-3xs);
    overflow-x: auto;
  }

  .swatch-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 68px;
    padding: var(--system-spacing-2xs);
    border: var(--system-border-width-sm) solid oklch(0 0 0 / 0.08);
    border-radius: var(--system-radius-2xs);
    text-align: left;
    cursor: pointer;
    transition: transform var(--system-motion-duration-fast) var(--system-motion-easing-default);
  }

  .swatch-cell:hover {
    transform: translateY(-1px);
  }

  .swatch-step {
    font: var(--system-font-label-xs);
    font-weight: var(--global-font-weight-04);
  }

  .swatch-hex {
    font-size: 11px;
    opacity: 0.92;
  }

  .swatch-l {
    font-size: 10px;
    opacity: 0.78;
  }

  .copy-toast {
    position: fixed;
    bottom: var(--system-spacing-md);
    right: var(--system-spacing-md);
    z-index: var(--system-z-index-toast);
    padding: var(--system-spacing-xs) var(--system-spacing-sm);
    background: var(--system-background-layer-2);
    color: var(--system-text-primary);
    border: var(--system-border-width-sm) solid var(--system-border-strong);
    border-radius: var(--system-radius-xs);
    box-shadow: var(--system-elevation-md);
    font: var(--system-font-mono-xs);
  }
</style>
