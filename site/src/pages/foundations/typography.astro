---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  cssName,
  dimensionToCss,
  loadTokenCatalog,
  resolveValue,
  toPx
} from '../../utils/tokens-loader.js'

const { lightTokens } = await loadTokenCatalog()

const typographyTokens = [...lightTokens.values()]
  .filter((t) => t.type === 'typography' && t.id.startsWith('system.font.'))
  .map((t) => {
    const resolved = resolveValue(t.node.$value, lightTokens)
    const cssVar = cssName(t.path)
    const group = t.path[2]
    const sizeKey = t.path[3]
    const px = toPx(resolved.fontSize)
    return {
      id: t.id,
      group,
      sizeKey,
      cssVar,
      fontSizeRem: dimensionToCss(resolved.fontSize),
      fontSizePx: px !== null ? `${px}px` : dimensionToCss(resolved.fontSize),
      fontWeight: resolved.fontWeight,
      lineHeight: resolved.lineHeight,
      letterSpacing: dimensionToCss(resolved.letterSpacing)
    }
  })

const groupOrder = ['display', 'heading', 'subheader', 'body', 'label', 'caption', 'mono']
const groupedTypography = groupOrder.map((group) => ({
  group,
  items: typographyTokens.filter((t) => t.group === group)
}))

const sampleTexts = {
  display: 'Dense Workspace Architecture',
  heading: 'Perceptual Contrast & Structural Hierarchy',
  subheader: 'System-level tokens calibrated for scannable data grids',
  body: 'Pact Design prioritizes high information density, crisp structural hierarchy, and perceptual contrast precision without decorative visual noise.',
  label: 'Export Configuration · ⌘E',
  caption: 'Updated 2026-11-05 · W3C DTCG 2025.10',
  mono: 'ID-2026-0048 · sha256:9f86d081 · 12.05 ms'
}

const metricsSampleRows = [
  { id: 'NODE-01', latency: '9.04 ms', throughput: '1,111.10 req/s', delta: '+0.12%' },
  { id: 'NODE-02', latency: '18.88 ms', throughput: '8,492.45 req/s', delta: '-4.89%' },
  { id: 'NODE-03', latency: '11.11 ms', throughput: '3,020.08 req/s', delta: '+11.11%' },
  { id: 'NODE-04', latency: '4.60 ms', throughput: '9,804.62 req/s', delta: '+0.05%' }
]
---

<BaseLayout title="Typography & Numerals">
  <header class="page-header">
    <span class="page-eyebrow">Foundations · Typography</span>
    <h1 class="page-title">Typography &amp; Numeric Precision</h1>
    <p class="page-desc">
      Pact Design 建立以 <code>body.md = 1rem (16px)</code> 與緊湊介面預設 <code>body.sm = 0.875rem (14px)</code> 為核心的 27 組複合排版 Token，同時提供原生 <code>system.font.mono.*</code> 等寬字體與 <code>.tabular-nums</code> 等寬數字對齊規範。
    </p>
  </header>

  <!-- Font Families -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">字體家族 (Font Families)</h2>
      <span class="section-subtitle">Proportional Sans-Serif &amp; Technical Monospace</span>
    </div>

    <div class="pact-grid pact-grid-2">
      <div class="pact-panel family-card">
        <div class="family-header">
          <strong>Sans-Serif (UI &amp; Prose)</strong>
          <code>--global-font-family-sans</code>
        </div>
        <p class="family-specimen" style="font-family: var(--global-font-family-sans);">
          Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz · 0123456789
        </p>
        <code class="family-stack">Inter, 'Open Sans', Roboto</code>
      </div>

      <div class="pact-panel family-card">
        <div class="family-header">
          <strong>Monospace (Identifiers, Hashes &amp; Code)</strong>
          <code>--global-font-family-mono</code>
        </div>
        <p class="family-specimen" style="font-family: var(--global-font-family-mono);">
          Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz · 0123456789
        </p>
        <code class="family-stack">SFMono-Regular, Menlo, Consolas, monospace</code>
      </div>
    </div>
  </section>

  <!-- Interactive Tabular Numerals Comparison -->
  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">表格數字垂直對齊 (.tabular-nums vs. Proportional)</h2>
      <span class="section-subtitle">Essential for financial tables, latency telemetry, and live counters</span>
    </div>

    <div class="pact-grid pact-grid-2">
      <div class="pact-panel">
        <div class="demo-box-header">
          <span class="pact-badge pact-badge-success">✓ Recommended: .tabular-nums</span>
          <code>font-variant-numeric: tabular-nums;</code>
        </div>
        <div class="pact-table-wrap">
          <table class="pact-table tabular-nums">
            <thead>
              <tr>
                <th>Node ID</th>
                <th style="text-align: right;">Latency</th>
                <th style="text-align: right;">Throughput</th>
                <th style="text-align: right;">24h Delta</th>
              </tr>
            </thead>
            <tbody>
              {metricsSampleRows.map((r) => (
                <tr>
                  <td class="mono">{r.id}</td>
                  <td style="text-align: right;">{r.latency}</td>
                  <td style="text-align: right;">{r.throughput}</td>
                  <td style="text-align: right;">{r.delta}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="pact-panel">
        <div class="demo-box-header">
          <span class="pact-badge pact-badge-warning">✗ Proportional Default</span>
          <code>font-variant-numeric: normal; (1 vs 8 width drift)</code>
        </div>
        <div class="pact-table-wrap">
          <table class="pact-table" style="font-variant-numeric: proportional-nums;">
            <thead>
              <tr>
                <th>Node ID</th>
                <th style="text-align: right;">Latency</th>
                <th style="text-align: right;">Throughput</th>
                <th style="text-align: right;">24h Delta</th>
              </tr>
            </thead>
            <tbody>
              {metricsSampleRows.map((r) => (
                <tr>
                  <td class="mono">{r.id}</td>
                  <td style="text-align: right;">{r.latency}</td>
                  <td style="text-align: right;">{r.throughput}</td>
                  <td style="text-align: right;">{r.delta}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- All 27 System Typography Scale Specimens -->
  {groupedTypography.map((section) => (
    <section class="section-block">
      <div class="section-header">
        <h2 class="section-title">system.font.{section.group}.*</h2>
        <span class="section-subtitle">{section.items.length} composite tokens</span>
      </div>

      <div class="pact-table-wrap">
        <table class="pact-table">
          <thead>
            <tr>
              <th style="width: 220px;">CSS Variable</th>
              <th style="width: 210px;">規格 (Size / Line / Weight / LS)</th>
              <th>實際渲染預覽 (Live Specimen)</th>
            </tr>
          </thead>
          <tbody>
            {section.items.map((item) => (
              <tr>
                <td>
                  <code>{item.cssVar}</code>
                </td>
                <td class="mono tabular-nums" style="color: var(--system-text-secondary);">
                  {item.fontSizePx} ({item.fontSizeRem}) / {item.lineHeight} · w{item.fontWeight} · {item.letterSpacing}
                </td>
                <td>
                  <div
                    class="type-specimen"
                    style={`font: var(${item.cssVar}); letter-spacing: var(${item.cssVar}-letter-spacing);`}
                  >
                    {sampleTexts[section.group]}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .family-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
  }

  .family-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--system-spacing-xs);
  }

  .family-specimen {
    margin: 0;
    padding: var(--system-spacing-sm);
    background: var(--system-background-layer-1);
    border: var(--system-border-width-sm) solid var(--system-border-subtle);
    border-radius: var(--system-radius-2xs);
    font-size: var(--global-font-size-06);
    line-height: var(--global-font-line-height-06);
  }

  .family-stack {
    color: var(--system-text-muted);
  }

  .demo-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--system-spacing-xs);
    margin-bottom: var(--system-spacing-sm);
  }

  .type-specimen {
    padding: var(--system-spacing-3xs) 0;
    color: var(--system-text-primary);
  }
</style>
