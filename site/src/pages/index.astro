---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../utils/url.js'

const principles = [
  {
    code: '01',
    title: 'Dense & Compact',
    desc: '專為高資訊密度介面設計，採用 24px–28px 緊湊控制項高度與 0px–4px 俐落圓角，最大化資料表格與多窗格工作區的可視範圍。'
  },
  {
    code: '02',
    title: 'Straightforward & Functional',
    desc: '屏除浮誇裝飾與彈跳動畫。所有動效嚴格控制在 0ms–200ms 的線性與標準緩動曲線內，每個 Token 皆服務於明確的結構或互動語意。'
  },
  {
    code: '03',
    title: 'Perceptual Contrast (APCA)',
    desc: '基於 OKLCH 均勻色彩空間（500 色階錨定於 L = 0.600），並以 WCAG 3.0 候選標準 APCA (|Lc|) 自動化測試驗證淺色與深色主題對比度。'
  }
]

const quickLinks = [
  {
    category: 'GETTING STARTED',
    title: 'Token Architecture',
    href: '/foundations/architecture',
    desc: '深入了解 W3C DTCG 2025.10 結構、Global → System → Component 三層架構與 CSS 變數命名規範。'
  },
  {
    category: 'FOUNDATIONS',
    title: 'Color & APCA Contrast',
    href: '/foundations/color',
    desc: '13 組 11 階 OKLCH 色票、深淺色語意背景/文字階層、以及 Solid 與 Subtle 狀態容器對比度檢視。'
  },
  {
    category: 'FOUNDATIONS',
    title: 'Typography & Numerals',
    href: '/foundations/typography',
    desc: '27 組複合排版字階（Display 至 Caption）、Monospace 等寬字體與 .tabular-nums 表格數字對齊展示。'
  },
  {
    category: 'FOUNDATIONS',
    title: 'Sizing & Spacing',
    href: '/foundations/sizing-spacing',
    desc: '緊湊控制項高度（24px–40px）、圖示尺寸、以及 4px 基準的模組化間距比例尺。'
  },
  {
    category: 'FOUNDATIONS',
    title: 'Border, Elevation & Motion',
    href: '/foundations/elevation-motion',
    desc: '邊框粗細、圓角、鍵盤導覽 Focus Ring 幾何設定（外擴、齊平、內縮）、Z-Index 與動效曲線。'
  }
]
---

<BaseLayout title="Overview">
  <header class="page-header">
    <h1 class="page-title">Pact Design</h1>
    <p class="page-desc">
      Pact Design 是一套領域中立（Domain-Neutral）的設計 Token 與介面系統，專為<strong>高密度、緊湊且直覺務實（Dense, Compact &amp; Straightforward）</strong>的專業 Web 應用程式打造。本網站完全採用 Pact Design 自身的 CSS Custom Properties 建構。
    </p>
  </header>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">核心設計哲學 (Core Philosophy)</h2>
      <span class="section-subtitle">Every token serves a clear structural or interactive purpose</span>
    </div>

    <div class="pact-grid pact-grid-3">
      {principles.map((p) => (
        <article class="pact-panel principle-card">
          <div class="principle-header">
            <span class="pact-badge pact-badge-primary">{p.code}</span>
            <h3 class="principle-title">{p.title}</h3>
          </div>
          <p class="principle-desc">{p.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">三層式 Token 架構 (3-Tier Hierarchy)</h2>
      <span class="section-subtitle">Single Source of Truth compiled via Style Dictionary v5</span>
    </div>

    <div class="pact-table-wrap">
      <table class="pact-table">
        <thead>
          <tr>
            <th>Tier 層級</th>
            <th>CSS 變數前綴</th>
            <th>職責說明</th>
            <th>範例 Token</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="pact-badge">1. Global</span></td>
            <td><code>--global-*</code></td>
            <td>原始色階與尺寸原子值（11 階 OKLCH 色票、rem 尺寸與間距、字重），不含語意情境。</td>
            <td><code>--global-indigo-500</code>, <code>--global-size-06</code></td>
          </tr>
          <tr>
            <td><span class="pact-badge pact-badge-primary">2. System</span></td>
            <td><code>--system-*</code></td>
            <td>具備語意角色與深淺主題（Light / Dark）感知的系統變數，為介面與元件的主要引用層。</td>
            <td><code>--system-background-layer-2</code>, <code>--system-semantic-primary</code></td>
          </tr>
          <tr>
            <td><span class="pact-badge pact-badge-info">3. Component</span></td>
            <td><code>--component-*</code></td>
            <td>特定緊湊型 UI 元件（Button、Table、Input）的專屬封裝變數，100% 指向 System 層。</td>
            <td><code>--system-control-height-sm</code>, <code>--system-focus-offset-inset</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section-block">
    <div class="section-header">
      <h2 class="section-title">探索文件 (Explore Documentation)</h2>
      <span class="section-subtitle">Foundations, specifications, and interactive component previews</span>
    </div>

    <div class="pact-grid pact-grid-3">
      {quickLinks.map((item) => (
        <a href={withBase(item.href)} class="pact-panel link-card">
          <span class="link-category">{item.category}</span>
          <strong class="link-title">{item.title} →</strong>
          <p class="link-desc">{item.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .principle-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-xs);
  }

  .principle-header {
    display: flex;
    align-items: center;
    gap: var(--system-spacing-xs);
  }

  .principle-title {
    margin: 0;
    font: var(--system-font-subheader-sm);
    color: var(--system-text-primary);
  }

  .principle-desc {
    margin: 0;
    font: var(--system-font-body-sm);
    color: var(--system-text-secondary);
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: var(--system-spacing-2xs);
    color: var(--system-text-primary);
    transition:
      border-color var(--system-motion-duration-fast) var(--system-motion-easing-default),
      background-color var(--system-motion-duration-fast) var(--system-motion-easing-default),
      box-shadow var(--system-motion-duration-fast) var(--system-motion-easing-default);
  }

  .link-card:hover {
    color: var(--system-text-primary);
    background: var(--system-background-hover);
    border-color: var(--system-border-strong);
    box-shadow: var(--system-elevation-xs);
  }

  .link-category {
    font: var(--system-font-mono-xs);
    color: var(--system-text-muted);
  }

  .link-title {
    font: var(--system-font-subheader-sm);
    color: var(--system-semantic-primary);
  }

  .link-desc {
    margin: 0;
    font: var(--system-font-body-xs);
    color: var(--system-text-secondary);
  }
</style>
