BRANCH=$(git symbolic-ref --short -q HEAD || echo "HEAD")

# Allow detached HEAD during git rebase / squash
if [ "$BRANCH" = "HEAD" ]; then
  exit 0
fi

VALID_BRANCH_REGEX="^(main|(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\/[a-z0-9]+(-[a-z0-9]+)*)$"

if ! echo "$BRANCH" | grep -Eq "$VALID_BRANCH_REGEX"; then
  echo ""
  echo "✖ Error: Invalid branch name '$BRANCH'."
  echo "  Branch names must be 'main' or follow '<type>/<kebab-case-name>'."
  echo "  Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Example: feat/date-picker, fix/button-focus-ring, chore/update-deps"
  echo ""
  exit 1
fi
